# SPDX-License-Identifier: LGPL-2.1-or-later
[Unit]
Description=KDE Passkey authenticator (KWallet backed, prototype)
PartOf=graphical-session.target
After=graphical-session.target plasma-kwallet-pam.service

[Service]
Type=dbus
BusName=org.kde.kpasskey
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/kpasskeyd
Restart=on-failure
Slice=session.slice
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
LimitCORE=0

[Install]
WantedBy=graphical-session.target
