[Unit]
Description=kpasskey TPM key helper socket

[Socket]
ListenStream=/run/kpasskey/tpm.sock
# Any local user may connect; the helper authorizes via SO_PEERCRED + logind.
SocketMode=0666
Accept=yes
MaxConnections=16
MaxConnectionsPerSource=4

[Install]
WantedBy=sockets.target
